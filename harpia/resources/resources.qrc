<RCC>
  <qresource prefix="/">
    <file>harpia.png</file>
    <!-- Bundled shaders, seeded into the user shaders folder on first run. -->
    <file alias="shaders/crt.frag">../editor/shader/presets/crt.frag</file>
    <file alias="shaders/adjust.frag">../editor/shader/presets/adjust.frag</file>
    <file alias="shaders/grayscale.frag">../editor/shader/presets/grayscale.frag</file>
    <file alias="shaders/vignette.frag">../editor/shader/presets/vignette.frag</file>
    <file alias="shaders/sharpen.frag">../editor/shader/presets/sharpen.frag</file>
    <file alias="shaders/grain.frag">../editor/shader/presets/grain.frag</file>
    <file alias="shaders/pixelate.frag">../editor/shader/presets/pixelate.frag</file>
    <file alias="shaders/backdrop.frag">../editor/shader/presets/backdrop.frag</file>
    <file alias="shaders/solid.frag">../editor/shader/presets/solid.frag</file>
    <file alias="shaders/gradient.frag">../editor/shader/presets/gradient.frag</file>
    <!-- Bundled transform scripts, seeded into the user scripts folder. -->
    <file alias="scripts/tutorial-zoom.js">../editor/script/presets/tutorial-zoom.js</file>
    <file alias="scripts/zoom-in.js">../editor/script/presets/zoom-in.js</file>
    <file alias="scripts/fade-in-out.js">../editor/script/presets/fade-in-out.js</file>
    <file alias="scripts/shake.js">../editor/script/presets/shake.js</file>
    <!-- Bundled example component, seeded into the user components folder. -->
    <file alias="components/pulse.js">../editor/component/presets/pulse.js</file>
  </qresource>
</RCC>
