# OBS's Qt SDK disables macdeployqt and QtTest. Build only missing components
# against that exact SDK, in a private prefix; never replace QtCore or select a
# deployment tool from an unrelated Homebrew installation.
include_guard(GLOBAL)

function(_harpia_qt_tools_source version output)
  set(HARPIA_QTBASE_SOURCE_DIR "" CACHE PATH "Optional matching complete qtbase source tree for an offline tools build")
  if(HARPIA_QTBASE_SOURCE_DIR)
    file(REAL_PATH "${HARPIA_QTBASE_SOURCE_DIR}" source)
  else()
    # Keep this checksum in sync with the Qt version in the pinned OBS SDK.
    if(version STREQUAL "6.11.1")
      set(hash d9594a31228aa23ad6b531719a29b45f0f3989fe6c136d45767ea179f233c1ac)
    else()
      message(FATAL_ERROR
        "The selected Qt ${version} SDK omits required tools. Set HARPIA_QTBASE_SOURCE_DIR "
        "to its matching complete qtbase source tree; automatic source download is pinned to Qt 6.11.1.")
    endif()
    set(cache "${CMAKE_SOURCE_DIR}/.deps/qt-tools/${version}")
    file(MAKE_DIRECTORY "${cache}")
    file(LOCK "${cache}/source.lock" GUARD FUNCTION TIMEOUT 60)
    set(name "qtbase-everywhere-src-${version}")
    set(archive "${cache}/${name}.tar.xz")
    set(source "${cache}/${name}")
    set(source_hash "")
    if(EXISTS "${cache}/source.sha256")
      file(READ "${cache}/source.sha256" source_hash)
    endif()
    if(NOT source_hash STREQUAL hash)
      set(valid_archive FALSE)
      if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
        if(actual STREQUAL hash)
          set(valid_archive TRUE)
        endif()
      endif()
      if(NOT valid_archive)
        string(REGEX MATCH "^[0-9]+\\.[0-9]+" series "${version}")
        set(url "https://download.qt.io/archive/qt/${series}/${version}/submodules/${name}.tar.xz")
        message(STATUS "Downloading matching Qt tools source: ${url}")
        file(DOWNLOAD "${url}" "${archive}.tmp" EXPECTED_HASH "SHA256=${hash}"
          TLS_VERIFY ON STATUS download_status)
        list(GET download_status 0 result)
        if(NOT result EQUAL 0)
          file(REMOVE "${archive}.tmp")
          message(FATAL_ERROR "Could not download Qt ${version} sources: ${download_status}")
        endif()
        file(RENAME "${archive}.tmp" "${archive}")
      endif()
      file(REMOVE_RECURSE "${source}")
      file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${cache}")
      file(WRITE "${cache}/source.sha256" "${hash}")
    endif()
  endif()

  if(NOT EXISTS "${source}/.cmake.conf" OR NOT EXISTS "${source}/src/testlib/CMakeLists.txt"
      OR NOT EXISTS "${source}/src/tools/macdeployqt/CMakeLists.txt")
    message(FATAL_ERROR "Incomplete qtbase source tree for Qt ${version}: ${source}")
  endif()
  file(READ "${source}/.cmake.conf" configuration)
  string(REGEX MATCH "set\\(QT_REPO_MODULE_VERSION[ \t]+\"?([0-9]+\\.[0-9]+\\.[0-9]+)\"?\\)" match "${configuration}")
  if(NOT match OR NOT CMAKE_MATCH_1 VERSION_EQUAL version)
    message(FATAL_ERROR "The qtbase source tree must match the selected Qt ${version} SDK: ${source}")
  endif()
  set(${output} "${source}" PARENT_SCOPE)
endfunction()

function(_harpia_run_qt_tools_step label log)
  # PARSE_ARGV preserves argument-local semicolons, including universal Mac
  # architecture lists, across this second function/list expansion.
  cmake_parse_arguments(PARSE_ARGV 2 step "" "" "")
  execute_process(COMMAND ${step_UNPARSED_ARGUMENTS} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${log}" "${output}\n${error}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Matching Qt tools ${label} failed (${result}). See ${log}\n${output}\n${error}")
  endif()
endfunction()

function(harpia_prepare_qt_tools)
  set(version "${Qt6Core_VERSION}")
  if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Cannot read the selected Qt SDK version to build its missing tools")
  endif()
  if(NOT TARGET Qt6::Core OR NOT EXISTS "${Qt6_DIR}/Qt6Config.cmake")
    message(FATAL_ERROR "Select a complete matching Qt SDK before preparing its missing tools")
  endif()
  get_filename_component(sdk "${Qt6_DIR}/../../.." REALPATH)
  set(wrapper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/qt-macos-tools")
  file(SHA256 "${wrapper}/CMakeLists.txt" wrapper_hash)
  file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" helper_hash)
  string(SHA256 signature "${version}|${Qt6_DIR}|${CMAKE_OSX_ARCHITECTURES}|${CMAKE_OSX_SYSROOT}|${CMAKE_OSX_DEPLOYMENT_TARGET}|${CMAKE_C_COMPILER}|${CMAKE_CXX_COMPILER}|${wrapper_hash}|${helper_hash}|${HARPIA_QTBASE_SOURCE_DIR}")
  string(SUBSTRING "${signature}" 0 16 key)
  set(root "${CMAKE_BINARY_DIR}/harpia-qt-tools/${version}-${key}")
  set(prefix "${root}/install")
  set(test_config "${prefix}/lib/cmake/Qt6Test/Qt6TestConfig.cmake")
  if(QT6_INSTALL_LIBS AND EXISTS "${prefix}/${QT6_INSTALL_LIBS}/cmake/Qt6Test/Qt6TestConfig.cmake")
    set(test_config "${prefix}/${QT6_INSTALL_LIBS}/cmake/Qt6Test/Qt6TestConfig.cmake")
  endif()
  get_filename_component(test_directory "${test_config}" DIRECTORY)
  if(Qt6Test_DIR)
    set(managed_root "${CMAKE_BINARY_DIR}/harpia-qt-tools")
    cmake_path(IS_PREFIX managed_root "${Qt6Test_DIR}" NORMALIZE managed_test)
    if((managed_test OR Qt6Test_DIR STREQUAL _HARPIA_QT_MANAGED_TEST_DIR)
        AND NOT Qt6Test_DIR STREQUAL test_directory)
      unset(Qt6Test_DIR CACHE)
      set(Qt6Test_DIR "")
      set(Qt6Test_DIR "" PARENT_SCOPE)
    endif()
  endif()
  set(build_deploy_tool OFF)
  set(build_testlib OFF)
  if(TARGET Qt6::macdeployqt)
    set(deploy_tool "$<TARGET_FILE:Qt6::macdeployqt>")
  elseif(HARPIA_MACDEPLOYQT)
    if(NOT EXISTS "${HARPIA_MACDEPLOYQT}" OR IS_DIRECTORY "${HARPIA_MACDEPLOYQT}")
      message(FATAL_ERROR "The selected macdeployqt does not exist: ${HARPIA_MACDEPLOYQT}")
    endif()
    set(deploy_tool "${HARPIA_MACDEPLOYQT}")
  else()
    set(hints "${Qt6_DIR}/../../../bin")
    if(Qt6CoreTools_DIR)
      list(APPEND hints "${Qt6CoreTools_DIR}/../../../bin")
    endif()
    if(QT6_INSTALL_PREFIX AND QT6_INSTALL_BINS)
      list(PREPEND hints "${QT6_INSTALL_PREFIX}/${QT6_INSTALL_BINS}")
    endif()
    find_program(matching_tool NAMES macdeployqt HINTS ${hints} NO_CACHE NO_DEFAULT_PATH)
    if(matching_tool)
      set(deploy_tool "${matching_tool}")
    else()
      set(build_deploy_tool ON)
    endif()
  endif()

  if(HARPIA_BUILD_TESTS AND NOT TARGET Qt6::Test)
    find_package(Qt6Test "${version}" EXACT QUIET CONFIG
      PATHS "${Qt6_DIR}/../Qt6Test" "${test_directory}" NO_DEFAULT_PATH)
    if(NOT TARGET Qt6::Test)
      set(build_testlib ON)
    endif()
  endif()
  if(NOT build_deploy_tool AND NOT build_testlib)
    set(HARPIA_MACDEPLOYQT "${deploy_tool}" PARENT_SCOPE)
    return()
  endif()

  set(required_missing FALSE)
  if(build_deploy_tool AND NOT EXISTS "${prefix}/bin/macdeployqt")
    set(required_missing TRUE)
  endif()
  if(build_testlib AND NOT EXISTS "${test_config}")
    set(required_missing TRUE)
  endif()
  if(required_missing)
    _harpia_qt_tools_source("${version}" source)
    file(MAKE_DIRECTORY "${root}")
    message(STATUS "Building missing Qt ${version} components: macdeployqt=${build_deploy_tool}, QtTest=${build_testlib}")
    set(configure_args
      -S "${wrapper}" -B "${root}/build" -G "Unix Makefiles"
      "-DCMAKE_BUILD_TYPE=Release" "-DCMAKE_INSTALL_PREFIX=${prefix}"
      "-DHARPIA_QT_VERSION=${version}" "-DHARPIA_QTBASE_SOURCE_DIR=${source}"
      "-DHARPIA_QT_BUILD_MACDEPLOYQT=${build_deploy_tool}" "-DHARPIA_QT_BUILD_TESTLIB=${build_testlib}"
      "-DQt6_DIR=${Qt6_DIR}" "-DQt6Core_DIR=${Qt6Core_DIR}")
    foreach(variable CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_C_COMPILER CMAKE_CXX_COMPILER)
      if(${variable})
        list(APPEND configure_args "-D${variable}=${${variable}}")
      endif()
    endforeach()
    if(CMAKE_OSX_ARCHITECTURES)
      string(REPLACE ";" "\\;" architectures "${CMAKE_OSX_ARCHITECTURES}")
      list(APPEND configure_args "-DCMAKE_OSX_ARCHITECTURES=${architectures}")
    endif()
    _harpia_run_qt_tools_step(configure "${root}/configure.log" "${CMAKE_COMMAND}" ${configure_args})
    _harpia_run_qt_tools_step(build "${root}/build.log" "${CMAKE_COMMAND}" --build "${root}/build" --parallel 4)
    _harpia_run_qt_tools_step(install "${root}/install.log" "${CMAKE_COMMAND}" --install "${root}/build" --config Release)
    if(QT6_INSTALL_LIBS AND EXISTS "${prefix}/${QT6_INSTALL_LIBS}/cmake/Qt6Test/Qt6TestConfig.cmake")
      set(test_config "${prefix}/${QT6_INSTALL_LIBS}/cmake/Qt6Test/Qt6TestConfig.cmake")
    endif()
  endif()
  if(build_deploy_tool)
    set(deploy_tool "${prefix}/bin/macdeployqt")
    if(NOT EXISTS "${deploy_tool}")
      message(FATAL_ERROR "The matching Qt tools build did not install macdeployqt: ${deploy_tool}")
    endif()
    # This tool is outside the SDK. Make its QLibraryInfo queries refer to the
    # SDK's plugins and frameworks, not to its small private install prefix.
    file(WRITE "${prefix}/bin/qt.conf" "[Paths]\nPrefix=${sdk}\nPlugins=plugins\nLibraries=lib\n")
  endif()
  if(build_testlib)
    if(NOT EXISTS "${test_config}")
      message(FATAL_ERROR "The matching Qt tools build did not install QtTest: ${test_config}")
    endif()
    get_filename_component(test_directory "${test_config}" DIRECTORY)
    set(Qt6Test_DIR "${test_directory}" CACHE PATH "Matching QtTest package for Harpia regression checks" FORCE)
    set(_HARPIA_QT_MANAGED_TEST_DIR "${test_directory}" CACHE INTERNAL "QtTest package built for the selected SDK" FORCE)
    set(Qt6Test_DIR "${test_directory}" PARENT_SCOPE)
  endif()
  set(HARPIA_MACDEPLOYQT "${deploy_tool}" PARENT_SCOPE)
endfunction()
